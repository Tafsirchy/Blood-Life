# ==============================================================================
# BLOOD&LIFE — Environment Configuration Example (.env.example)
# ==============================================================================

# Database Connection (MongoDB Atlas)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blood-life?retryWrites=true&w=majority"

# Authentication Secrets (Generate 32+ characters)
AUTH_SECRET="your_secure_random_auth_secret_key_minimum_32_characters"
JWT_SECRET="your_secure_random_jwt_secret_key_minimum_32_characters"

# Application Public Host URL (Used for absolute email verification & reset links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional Email Service (Resend API)
# Free-tier default: use "onboarding@resend.dev" until custom domain is DNS-verified
RESEND_API_KEY="re_..."
EMAIL_FROM="BLOOD&LIFE Emergency <onboarding@resend.dev>"

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."
VAPID_PRIVATE_KEY="..."
VAPID_EMAIL="mailto:alert@bloodandlife.org"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="bloodlife"
CLOUDINARY_API_KEY="594847938798817"
CLOUDINARY_API_SECRET="..."

# Cron Jobs Authorization
CRON_SECRET="your_secure_cron_dispatch_secret"
